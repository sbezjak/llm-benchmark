# Copy to `.env` and fill in. `.env` is gitignored - never commit real keys.
# Paid providers (the billed sweep; `-m "not billed"` runs need none of these):
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# Langfuse tracing (optional - only if exporting runs to a Langfuse project):
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=
